#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        shift_tab {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <12 13>;
        };

        alt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <20 21>;
        };

        f2 {
            bindings = <&kp F2>;
            key-positions = <19 20>;
            layers = <0>;
        };

        henkan {
            bindings = <&kp INT_HENKAN>;
            key-positions = <18 19>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <12 11>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <10 11>;
        };

        function {
            bindings = <&to 3>;
            key-positions = <41 38>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q   &kp L   &kp U   &kp F             &trans                                                              &trans       &kp W              &lt 5 R  &kp Y  &kp P
&kp E   &kp I   &kp A   &mt LEFT_SHIFT O  &kp MINUS        &trans                      &trans                 &kp K        &mt RIGHT_SHIFT T  &kp N    &kp S  &kp H
&kp Z   &kp X   &kp C   &kp V             &kp COMMA        &kp LEFT_WIN                &kp K_APPLICATION      &kp G        &kp D              &kp M    &kp J  &kp B
&trans  &trans  &trans  &kp DELETE        &lt 2 BACKSPACE  &mt LEFT_CONTROL ENTER      &mt RIGHT_CONTROL TAB  &lt 1 SPACE                                     &to 6
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        red {
            bindings = <
&kp AT_SIGN    &kp LEFT_BRACKET      &kp DOUBLE_QUOTES  &kp RIGHT_BRACKET             &trans                                       &trans  &kp LC(PAGE_UP)  &kp UP_ARROW    &kp RC(PAGE_DOWN)  &trans
&kp HASH       &kp LEFT_PARENTHESIS  &kp SQT            &mt LSHIFT RIGHT_PARENTHESIS  &kp AMPERSAND  &trans                &trans  &trans  &kp LEFT         &kp DOWN_ARROW  &kp RIGHT          &trans
&kp BACKSLASH  &kp LEFT_BRACE        &kp GRAVE          &kp RIGHT_BRACE               &kp PIPE       &trans                &trans  &trans  &kp HOME         &trans          &kp END            &trans
&trans         &trans                &trans             &trans                        &to 4          &kp LEFT_CONTROL      &trans  &trans                                                      &trans
            >;
        };

        yellow {
            bindings = <
&kp TILDE   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans                                     &kp CARET  &kp LESS_THAN    &kp KP_EQUAL  &kp GREATER_THAN  &kp PERCENT
&kp N0      &kp NUMBER_4  &kp N5        &kp NUMBER_6  &trans      &trans      &trans             &kp UNDER  &mt RSHIFT PLUS  &kp MINUS     &kp ASTRK         &kp SLASH
&kp DOLLAR  &kp N7        &kp N8        &kp N9        &kp PERIOD  &trans      &trans             &trans     &kp EXCL         &kp QUESTION  &kp COLON         &kp SEMI
&trans      &trans        &trans        &trans        &trans      &trans      &kp RIGHT_CONTROL  &trans                                                      &trans
            >;
        };

        gray {
            bindings = <
&kp F1  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans   &kp F12
&kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &trans      &trans  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                           &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
