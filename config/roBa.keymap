#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

//OS設定を日本語キーボードのまま使用するための変換定義
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp K_APPLICATION>;
            key-positions = <0 10>;
            timeout-ms = <50>;
        };

        APPLICATION {
            bindings = <&kp ESCAPE>;
            key-positions = <1 11>;
            timeout-ms = <50>;
        };

        f2 {
            bindings = <&kp F2>;
            key-positions = <2 12>;
            timeout-ms = <50>;
        };

        muhenkan {
            bindings = <&kp INT_MUHENKAN>;
            key-positions = <3 13>;
            timeout-ms = <50>;
        };

        henkan {
            bindings = <&kp INT_HENKAN>;
            key-positions = <6 18>;
            timeout-ms = <50>;
        };

        comma {
            bindings = <&kp COMMA>;
            key-positions = <7 19>;
            timeout-ms = <50>;
        };

        dot {
            bindings = <&kp PERIOD>;
            key-positions = <8 20>;
            timeout-ms = <50>;
        };
    };

    // Red(1) と Yellow(2) を同時に有効にすると Gray(3) へ
    conditional_layers {
        compatible = "zmk,conditional-layers";

        function_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        // ホームロウ修飾用。直前 150ms 以内に他キーを打っていたら必ずタップ扱い
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <150>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    // 未使用ポジション: 4 5 15 16 27 28 34 35 36 (全レイヤー &none)
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q            &kp L            &kp U                &kp F                  &none                                                           &none        &kp W               &lt 5 R               &kp Y             &kp P
&hrm LEFT_ALT E  &hrm LEFT_GUI I  &hrm LEFT_CONTROL A  &hrm LEFT_SHIFT O      &kp MINUS        &none                   &none                  &kp K        &hrm RIGHT_SHIFT T  &hrm RIGHT_CONTROL N  &hrm RIGHT_GUI S  &hrm RIGHT_ALT H
&kp Z            &kp X            &kp C                &kp V                  &kp COMMA        &none                   &none                  &kp G        &kp D               &kp M                 &kp J             &kp B
&none            &none            &none                &mt LEFT_SHIFT DELETE  &lt 2 BACKSPACE  &mt LEFT_CONTROL ENTER  &mt RIGHT_CONTROL TAB  &lt 1 SPACE                                                              &mo 6
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        red {
            bindings = <
&kp JP_AT           &kp JP_LBRACKET          &kp JP_DQUOTE               &kp JP_RBRACKET            &none                             &none       &kp LC(PAGE_UP)  &kp UP_ARROW    &kp RC(PAGE_DOWN)  &trans
&hrm LEFT_ALT HASH  &hrm LEFT_GUI JP_LPAREN  &hrm LEFT_CONTROL JP_QUOTE  &hrm LEFT_SHIFT JP_RPAREN  &kp JP_AMPERSAND  &none   &none   &kp DELETE  &kp LEFT         &kp DOWN_ARROW  &kp RIGHT          &hrm RIGHT_ALT ENTER
&kp JP_YEN          &kp JP_LBRACE            &kp JP_BACKQUOTE            &kp JP_RBRACE              &kp JP_PIPE       &none   &none   &trans      &kp HOME         &kp F6          &kp END            &trans
&none               &none                    &none                       &trans                     &trans            &trans  &trans  &trans                                                          &trans
            >;
        };

        yellow {
            bindings = <
&kp JP_TILDE            &kp COMMA               &kp PERIOD                  &kp JP_CARET              &none                         &none              &kp JP_PLUS                &kp MINUS                    &kp JP_ASTERISK          &kp SLASH
&hrm LEFT_ALT NUMBER_1  &hrm LEFT_GUI NUMBER_2  &hrm LEFT_CONTROL NUMBER_3  &hrm LEFT_SHIFT NUMBER_4  &kp NUMBER_5  &none   &none   &kp NUMBER_6       &hrm RIGHT_SHIFT NUMBER_7  &hrm RIGHT_CONTROL NUMBER_8  &hrm RIGHT_GUI NUMBER_9  &hrm RIGHT_ALT NUMBER_0
&kp DOLLAR              &kp LESS_THAN           &kp JP_EQUAL                &kp GREATER_THAN          &kp PERCENT   &none   &none   &kp JP_UNDERSCORE  &kp EXCL                   &kp QUESTION                 &kp SEMI                 &kp JP_COLON
&none                   &none                   &none                       &trans                    &trans        &trans  &trans  &trans                                                                                              &trans
            >;
        };

        gray {
            bindings = <
&trans            &trans            &trans                &trans              &none                    &none    &trans               &trans                 &trans             &trans
&hrm LEFT_ALT F1  &hrm LEFT_GUI F2  &hrm LEFT_CONTROL F3  &hrm LEFT_SHIFT F4  &kp F5   &none   &none   &kp F6   &hrm RIGHT_SHIFT F7  &hrm RIGHT_CONTROL F8  &hrm RIGHT_GUI F9  &hrm RIGHT_ALT F10
&kp F11           &kp F12           &kp F13               &kp F14             &kp F15  &none   &none   &kp F16  &kp F17              &kp F18                &kp F19            &kp F20
&none             &none             &none                 &trans              &trans   &trans  &trans  &trans                                                                  &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &none                   &none   &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans    &trans    &trans    &trans
&none   &none   &none   &trans  &trans  &trans  &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &none                   &none   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &none   &none   &trans  &trans  &trans  &trans  &trans
&none   &none   &none   &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &none                   &none         &trans        &trans        &trans        &bootloader
&trans  &trans  &trans  &trans  &trans  &none   &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &none   &trans  &trans  &trans  &none   &none   &trans        &trans        &trans        &bt BT_CLR    &bt BT_CLR_ALL
&none   &none   &none   &trans  &trans  &trans  &trans  &trans                                                  &trans
            >;
        };
    };
};
